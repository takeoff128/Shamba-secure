# Copy this file to .env and fill in real values before starting the server.

# A long, random, secret string used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Port the app listens on (most hosts set this for you automatically)
PORT=3000

# Set to "production" once deployed behind HTTPS so login cookies are marked secure
NODE_ENV=development

# Optional: where the SQLite database file lives. Leave unset for local dev
# (defaults to ./data). On a managed platform, set this to your attached
# persistent volume's mount path, e.g. /data — otherwise your database gets
# wiped on every redeploy.
DATA_DIR=

# --- SMS reminders (optional) ---
# Sign up free at https://africastalking.com to get these.
# Use username "sandbox" + your sandbox API key to test without paying for real SMS.
# Leave these blank to run without SMS — reminders will just be logged to the console.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- Password reset emails (optional) ---
# Any SMTP provider works: Gmail (with an app password), SendGrid, Mailgun,
# Postmark, etc. Leave blank to run without email — reset links will just
# be logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Web push notifications (optional) ---
# In-app notifications for anyone who's installed the app (Add to Home
# Screen), as a second channel alongside SMS. Generate a keypair once with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave blank to run without push — SMS reminders still work either way.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
