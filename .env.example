# Copy this file to .env and fill in real values before starting the server.

# A long, random, secret string used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Port the app listens on (most hosts set this for you automatically)
PORT=3000

# Set to "production" once deployed behind HTTPS so login cookies are marked secure
NODE_ENV=development

# Optional: where the SQLite database file lives. Leave unset for local dev
# (defaults to ./data). On a managed platform, set this to your attached
# persistent volume's mount path, e.g. /data — otherwise your database gets
# wiped on every redeploy.
DATA_DIR=

# --- SMS reminders (optional) ---
# Sign up free at https://africastalking.com to get these.
# Use username "sandbox" + your sandbox API key to test without paying for real SMS.
# Leave these blank to run without SMS — reminders will just be logged to the console.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- Account verification & password reset emails (optional) ---
# Two options — set ONE of these, not both. If RESEND_API_KEY is set, it's
# used and the SMTP settings below are ignored.
#
# Option 1 (recommended on Railway Free/Hobby, and similar hosts that block
# outbound SMTP): Resend, over a normal HTTPS API call instead of SMTP.
# Sign up free at https://resend.com (3,000 emails/month free).
# Without a verified domain, RESEND_FROM must stay onboarding@resend.dev,
# and emails can only be delivered to the address your Resend account was
# signed up with — fine for testing, not for real users. Verify a domain at
# resend.com/domains to send to anyone.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Option 2: any SMTP provider — Gmail (with an app password), SendGrid,
# Mailgun, Postmark, etc. Only works on hosts that allow outbound SMTP
# (e.g. Railway Pro+ — NOT Free/Hobby, which blocks ports 465/587 entirely).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Leave both options blank to run without email — codes/reset links will
# just be logged to the console instead of sent.

# --- Web push notifications (optional) ---
# In-app notifications for anyone who's installed the app (Add to Home
# Screen), as a second channel alongside SMS. Generate a keypair once with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave blank to run without push — SMS reminders still work either way.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
